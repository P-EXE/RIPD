<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RIPDApp.Views.StatisticTileV">

  <Border Padding="10"
          StrokeThickness="0"
          StrokeShape="RoundRectangle 10"
          Background="#10FFFFFF">
    
    <VerticalStackLayout>
      
      <HorizontalStackLayout Spacing="10">
        <Label Text="56 KCal"
               FontSize="Title"
               VerticalOptions="Center"/>
        <Label Text="-12%"
               FontSize="Default"
               VerticalOptions="Center"
               TextColor="#FF4050"/>
      </HorizontalStackLayout>
      <Label Text="Category"
             FontSize="Caption"/>
      
    </VerticalStackLayout>
    
  </Border>

</ContentView>
