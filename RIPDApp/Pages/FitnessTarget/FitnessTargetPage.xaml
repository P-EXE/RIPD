<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RIPDApp.ViewModels"
             x:Class="RIPDApp.Pages.FitnessTargetPage"
             x:DataType="vm:FitnessTargetVM"
             Title="">
  <Grid RowDefinitions="*, auto">
    
    <VerticalStackLayout Grid.Row="0">
      <Label Text="Weight"/>
      <Entry Text="{Binding FitnessTarget.Weight}"/>
      <Label Text="Date"/>
      <DatePicker Date="{Binding FitnessTarget.TargetDateTime}"/>
    </VerticalStackLayout>

    <Button Grid.Row="1" Text="Update" Command="{Binding UpdateCommand}"/>
    
  </Grid>
</ContentPage>