<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:RIPDApp.Views"
             xmlns:vm="clr-namespace:RIPDApp.ViewModels"
             x:Class="RIPDApp.Pages.DiaryWeekPage"
             x:DataType="vm:DiaryVM"
             Title="">
  <VerticalStackLayout>

    <Grid ColumnDefinitions="*, *" ColumnSpacing="4" Padding="4">
      <VerticalStackLayout Grid.Column="0" Spacing="4">
        <v:StatisticTileV FlexLayout.Grow="1"/>
        <v:StatisticTileV FlexLayout.Grow="1"/>
        <v:StatisticTileV FlexLayout.Grow="1"/>
      </VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1" Spacing="4">
        <v:StatisticTileV FlexLayout.Grow="1"/>
        <v:StatisticTileV FlexLayout.Grow="1"/>
      </VerticalStackLayout>
    </Grid>

    <v:BarChartV Values="{Binding FoodEntriesKCals}" />

    <CollectionView SelectionMode="Single"
                    ItemsSource="{Binding FoodEntries}">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <HorizontalStackLayout>
            <VerticalStackLayout>
              <Label Text="Food Name"/>
              <Label Text="Food Manufacturer"/>
            </VerticalStackLayout>
            <Label Text="100 pc."/>
            <Label Text="10.13."/>
          </HorizontalStackLayout>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

  </VerticalStackLayout>
</ContentPage>