<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:RIPDApp.Views.Diary"
             xmlns:vm="clr-namespace:RIPDApp.ViewModels"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="RIPDApp.Pages.DiaryTodayPage"
             x:DataType="vm:DiaryVM">

  <Grid RowDefinitions="auto,auto,auto">
    <v:DiaryFoodListV Grid.Row="0"/>
    <v:DiaryWorkoutListV Grid.Row="1"/>
    <Label Text="Consumed Calories" Grid.Row="2" ZIndex="1" Margin="5,0,0,0" TextColor="LimeGreen"/>
    <micro:ChartView Grid.Row="2" Chart="{Binding TodayChartView}" HeightRequest="300" VerticalOptions="StartAndExpand"/>
    <Label Text="Burned Calories" Grid.Row="1" ZIndex="1" HorizontalTextAlignment="End" Margin="5,0,5,0" TextColor="Red"/>
    <micro:ChartView Grid.Row="2" Chart="{Binding TodayChartView1}" Margin="0,270,0,0" HeightRequest="300" VerticalOptions="StartAndExpand"/>
  </Grid>
</ContentPage>