<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RIPDApp.ViewModels"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             x:Class="RIPDApp.Pages.RunPage"
             x:DataType="vm:RunVM"
             Title="">

  <Grid RowDefinitions="*,auto">
    
    <ScrollView Grid.Row="0">
      <CollectionView ItemsSource="{Binding Locations}">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="sensors:Location">
            <VerticalStackLayout>
              <Label Text="{Binding Latitude}"/>
              <Label Text="{Binding Longitude}"/>
            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </ScrollView>
    
    <VerticalStackLayout Grid.Row="1">
      <Button Text="Start getting Location" Command="{Binding StartGettingLocationCommand}" IsVisible="{Binding IsNotListening}"/>
      <Button Text="Stop gettting Location" Command="{Binding StopGettingLocationCommand}" IsVisible="{Binding IsListening}"/>
    </VerticalStackLayout>
    
  </Grid>
</ContentPage>